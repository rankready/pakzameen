---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Figure from '../components/Figure.astro';
import PackageCard from '../components/PackageCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, whyUs, umrahPackages, testimonials } from '../data/content';
import { img, tourImage } from '../data/images';

const popular = ['Hunza & Skardu', 'Dubai & Abu Dhabi', 'Turkey Highlights', 'Naran & Kaghan'];
---

<BaseLayout>
  <Hero />

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What we do</span>
        <h2>Everything for your journey, in one place</h2>
        <p>From the sacred pilgrimage to a family holiday, Pakzameen handles the details so you can travel with peace of mind.</p>
      </div>
      <div class="grid cols-3">
        {services.map((s) => (
          <a href={s.href} class="service card">
            <span class="service-icon"><Icon name={s.icon} size={26} /></span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="service-more">Learn more <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Popular destinations -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Popular right now</span>
        <h2>Destinations our travellers love</h2>
        <p>Hand-picked tours across the north of Pakistan and beyond, at prices that make sense.</p>
      </div>
      <div class="grid cols-4 dest-grid">
        {popular.map((d) => (
          <a href="/tours" class="dest">
            <Figure src={tourImage[d]} alt={d} ratio="3 / 4" />
            <span class="dest-name">{d}</span>
          </a>
        ))}
      </div>
      <div class="center-btn">
        <a href="/tours" class="btn btn--ghost">See all tour packages <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Umrah highlight -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Labbaik Allahumma Labbaik</span>
        <h2>Umrah packages for every budget</h2>
        <p>Complete Umrah packages with visa, flights and hotels near the Haram. Customisable for families and groups.</p>
      </div>
      <div class="grid cols-3">
        {umrahPackages.map((p) => <PackageCard pkg={p} kind="Umrah" />)}
      </div>
      <div class="center-btn">
        <a href="/umrah" class="btn btn--ghost">View full Umrah details <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section section--ink whyus">
    <div class="container">
      <div class="whyus-grid">
        <div class="whyus-intro">
          <span class="eyebrow eyebrow--light">Why Pakzameen</span>
          <h2>Travel with people who care about the details</h2>
          <p>We treat every booking like it's our own family travelling. That means honest advice, fair prices and someone to call whenever you need us.</p>
          <Figure src={img.happyTravellers} alt="Happy travellers" ratio="16 / 9" class="whyus-photo" />
        </div>
        <ul class="whyus-list">
          {whyUs.map((f) => (
            <li>
              <span class="whyus-icon"><Icon name={f.icon} size={24} /></span>
              <div>
                <h3>{f.title}</h3>
                <p>{f.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Kind words</span>
        <h2>Loved by travellers &amp; pilgrims</h2>
      </div>
      <div class="grid cols-3">
        {testimonials.map((t) => (
          <blockquote class="tst card">
            <div class="stars" aria-label="5 out of 5 stars">
              {[1,2,3,4,5].map(() => <Icon name="star" size={16} />)}
            </div>
            <p>“{t.quote}”</p>
            <footer><strong>{t.name}</strong><span>{t.location}</span></footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .service {
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    color: var(--text);
  }
  .service-icon {
    display: inline-grid;
    place-items: center;
    width: 54px; height: 54px;
    border-radius: 14px;
    background: var(--orange-soft);
    color: var(--orange-dark);
    margin-bottom: 1rem;
  }
  .service h3 { margin-bottom: 0.4rem; }
  .service p { color: var(--muted); font-size: 0.95rem; flex: 1; }
  .service-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--orange-dark);
    margin-top: 0.6rem;
  }
  .service:hover .service-more { gap: 0.6rem; }

  .dest { position: relative; display: block; }
  .dest-name {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
    z-index: 2;
  }
  .dest :global(.figure)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent 55%);
    z-index: 1;
  }

  .center-btn { text-align: center; margin-top: 2.2rem; }

  /* Why us */
  .whyus-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 940px) { .whyus-grid { grid-template-columns: 1fr 1fr; align-items: start; } }
  .whyus-intro p { color: #c9c3ba; margin-bottom: 1.6rem; }
  .whyus-photo { margin-top: 0.5rem; }
  .whyus-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.4rem; }
  .whyus-list li { display: flex; gap: 1rem; }
  .whyus-icon {
    display: inline-grid;
    place-items: center;
    width: 50px; height: 50px;
    flex-shrink: 0;
    border-radius: 12px;
    background: rgba(232, 119, 34, 0.16);
    color: var(--orange);
  }
  .whyus-list h3 { font-size: 1.15rem; margin-bottom: 0.25rem; }
  .whyus-list p { color: #b3aca2; font-size: 0.95rem; margin: 0; }
  .eyebrow--light { color: #ffb877; }

  /* Testimonials */
  .tst { padding: 1.6rem; margin: 0; }
  .stars { display: flex; gap: 2px; color: #f5a623; margin-bottom: 0.8rem; }
  .stars :global(svg) { fill: #f5a623; }
  .tst p { font-size: 1rem; color: var(--text); }
  .tst footer { display: flex; flex-direction: column; }
  .tst strong { font-family: var(--font-head); color: var(--ink); }
  .tst span { font-size: 0.85rem; color: var(--muted); }
</style>
