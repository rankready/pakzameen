---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found">
  <section class="nf">
    <div class="container">
      <span class="eyebrow">Error 404</span>
      <h1>This page has flown off course</h1>
      <p>The page you're looking for doesn't exist or has moved. Let's get you back on track.</p>
      <div class="nf-actions">
        <a href="/" class="btn">Back to home <Icon name="arrow" size={16} /></a>
        <a href="/contact" class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding-block: clamp(4rem, 10vw, 7rem); text-align: center; }
  .nf p { color: var(--muted); max-width: 44ch; margin-inline: auto; }
  .nf-actions { display: flex; gap: 0.9rem; justify-content: center; margin-top: 1.6rem; flex-wrap: wrap; }
</style>
