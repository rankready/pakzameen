---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Figure from '../components/Figure.astro';
import { tours } from '../data/content';
import { img } from '../data/images';
import { links } from '../data/site';

const highlights = [
  'Visa guidance & processing',
  'Return air ticket',
  'Hotels & daily breakfast',
  'Airport & sightseeing transfers',
  'Guided tours of Baku & Gabala',
];
---

<BaseLayout
  title="Azerbaijan Tour Packages"
  description="Azerbaijan tour packages from Pakzameen Travels and Tours — explore Baku, Gabala and the Caspian coast with visa, flights, hotels and sightseeing."
>
  <PageHero
    crumb="Tours"
    title="Azerbaijan Tour Packages"
    subtitle="Discover the beauty of Azerbaijan — Baku's Old City and Flame Towers, the Caspian coast, and the mountains and waterfalls of Gabala."
    image={img.baku}
  />

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Our packages</span>
        <h2>Azerbaijan, done right</h2>
        <p>All tours include transport, accommodation and a planned itinerary. Durations and prices are indicative and fully customisable for families, friends and groups.</p>
      </div>

      <div class="grid cols-3 tour-grid">
        {tours.map((t) => (
          <article class="tour card">
            <div class="tour-media">
              <Figure src={img.baku} alt={t.destination} ratio="16 / 10" rounded={false} />
              <span class="tour-tag">Azerbaijan</span>
            </div>
            <div class="tour-body">
              <h3>{t.destination}</h3>
              <p class="tour-meta"><Icon name="clock" size={15} /> {t.duration}</p>
              <p class="tour-blurb">{t.blurb}</p>
              <div class="tour-foot">
                <span class="tour-price">From <strong>{t.priceFrom}</strong></span>
                <a
                  href={links.whatsapp(`Assalam-o-Alaikum! I'd like details on the ${t.destination} (Azerbaijan) tour package.`)}
                  class="btn btn--ghost btn-sm"
                  target="_blank"
                  rel="noopener"
                >Enquire</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">What's included</span>
          <h2>Everything taken care of</h2>
          <p class="muted">Our Azerbaijan packages are complete — just pack your bags. Add extra nights, upgrade hotels or add a private guide any time.</p>
          <ul class="pts">
            {highlights.map((h) => <li><Icon name="check" size={18} /> {h}</li>)}
          </ul>
        </div>
        <Figure src={img.baku} alt="Baku, Azerbaijan" ratio="4 / 3" class="split-img" />
      </div>
    </div>
  </section>

  <CtaBand title="Ready to explore Azerbaijan?" text="Tell us your dates and group size and we'll tailor the perfect Baku getaway." />
</BaseLayout>

<style>
  .tour { overflow: hidden; display: flex; flex-direction: column; }
  .tour-media { position: relative; }
  .tour-tag {
    position: absolute; top: 0.8rem; left: 0.8rem;
    background: rgba(20,24,28,0.82); color: #fff;
    font-size: 0.72rem; font-family: var(--font-head); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.05em;
    padding: 0.3rem 0.7rem; border-radius: 999px;
  }
  .tour-body { padding: 1.3rem; display: flex; flex-direction: column; flex: 1; }
  .tour-body h3 { margin-bottom: 0.35rem; }
  .tour-meta { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--muted); font-size: 0.85rem; margin: 0 0 0.6rem; }
  .tour-blurb { color: var(--muted); font-size: 0.93rem; flex: 1; }
  .tour-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 0.9rem; }
  .tour-price { font-size: 0.85rem; color: var(--muted); }
  .tour-price strong { font-family: var(--font-head); font-size: 1.15rem; color: var(--orange-dark); display: block; }
  .btn-sm { padding: 0.55rem 1.1rem; font-size: 0.88rem; }

  .split { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .split { grid-template-columns: 1.1fr 1fr; } }
  .muted { color: var(--muted); }
  .pts { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; gap: 0.6rem; }
  .pts li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; }
  .pts svg { color: var(--green); flex-shrink: 0; }
</style>
