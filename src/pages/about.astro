---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Figure from '../components/Figure.astro';
import { whyUs } from '../data/content';
import { img } from '../data/images';
import { site } from '../data/site';

const values = [
  { icon: 'shield', title: 'Trust', desc: 'Honest advice and transparent pricing on every booking.' },
  { icon: 'star', title: 'Care', desc: 'We treat your journey as if it were our own family\'s.' },
  { icon: 'check', title: 'Reliability', desc: 'What we promise is what we deliver — every time.' },
];
---

<BaseLayout
  title="About Us"
  description="Learn about Pakzameen Travels and Tours — a trusted travel company based in Sargodha, Pakistan, serving pilgrims and travellers."
>
  <PageHero
    crumb="About"
    title="About Pakzameen"
    subtitle="A trusted travel company from the heart of Sargodha, dedicated to making every journey simple, affordable and memorable."
    image={img.team}
  />

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">Our story</span>
          <h2>Travel made simple, from Sargodha to the world</h2>
          <p>{site.name} was built on a simple belief: that arranging travel — whether a sacred pilgrimage or a family holiday — should be easy, honest and stress-free. From our office on Mian Khan Road in Sargodha, we help travellers across Pakistan reach their destinations with confidence.</p>
          <p>Over the years we've helped thousands of pilgrims perform Umrah and Hajj, booked countless flights and visas, and taken families to the mountains of the north and cities around the world. Whatever your journey, we're here to plan it with care.</p>
          <div class="about-actions">
            <a href="/contact" class="btn">Get in touch <Icon name="arrow" size={16} /></a>
            <a href="/umrah" class="btn btn--ghost">Our packages</a>
          </div>
        </div>
        <Figure src={img.happyTravellers} alt="Travellers on a journey" ratio="4 / 5" class="split-media" />
      </div>
    </div>
  </section>

  <!-- Director profile. To add a real photo, drop it in /public and swap the
       .owner-avatar monogram for <img src="/owais.jpg" alt="Muhammad Owais" />. -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Meet the Director</span>
        <h2>Leadership you can trust</h2>
      </div>
      <div class="owner card">
        <div class="owner-media">
          <div class="owner-avatar" aria-hidden="true">MO</div>
        </div>
        <div class="owner-body">
          <h3>Muhammad Owais</h3>
          <p class="owner-role">Director — Pakzameen Travels and Tours</p>
          <p>
            Muhammad Owais leads Pakzameen Travels and Tours with a hands-on, personal
            approach — treating every pilgrim and traveller like family. Based in Sargodha,
            he is dedicated to making travel from Pakistan simpler, more affordable and more
            reliable, whether it's a sacred pilgrimage or a family holiday.
          </p>
          <p>
            A passionate traveller himself, he has explored <strong>10+ countries</strong> —
            first-hand experience that shapes the routes, tips and destinations he recommends
            to every client.
          </p>
          <p>
            His commitment reaches the international stage: he is a registered participant in
            the <strong>II World Congress of Inland Tourism</strong> (Guarda, Portugal, November 2026),
            organised by the Associação Ibérica de Turismo do Interior (AITI) — bringing global
            tourism expertise back to every journey Pakzameen plans.
          </p>
          <ul class="owner-facts">
            <li><Icon name="star" size={16} /> Director &amp; travel specialist</li>
            <li><Icon name="plane" size={16} /> Passionate traveller — visited 10+ countries</li>
            <li><Icon name="pin" size={16} /> Based in Sargodha, Pakistan</li>
            <li><Icon name="globe" size={16} /> International tourism delegate (AITI, Portugal 2026)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What we stand for</span>
        <h2>Our values</h2>
      </div>
      <div class="grid cols-3">
        {values.map((v) => (
          <div class="value card">
            <span class="value-icon"><Icon name={v.icon} size={26} /></span>
            <h3>{v.title}</h3>
            <p>{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Why choose us</span>
        <h2>The Pakzameen difference</h2>
      </div>
      <div class="grid cols-4">
        {whyUs.map((f) => (
          <div class="feat">
            <span class="feat-icon"><Icon name={f.icon} size={24} /></span>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink recog">
    <div class="container">
      <div class="recog-grid">
        <div class="recog-badge">
          <Icon name="globe" size={40} />
        </div>
        <div class="recog-body">
          <span class="eyebrow eyebrow--light">International participation</span>
          <h2>Representing Pakzameen on the world stage</h2>
          <p>
            Our Director, <strong>Muhammad Owais</strong>, is a registered participant in the
            <strong> II World Congress of Inland Tourism</strong>, held on 18–19 November 2026 at the
            Teatro Municipal da Guarda in Guarda, Portugal — organised by the
            Associação Ibérica de Turismo do Interior (AITI).
          </p>
          <p class="recog-note">
            This international event brings together institutional representatives, academics and
            tourism professionals from around the world to share knowledge on developing tourism —
            part of our commitment to bringing global expertise to every journey we plan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .split { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .split { grid-template-columns: 1.2fr 1fr; } }
  .about-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.6rem; }

  .value { text-align: center; padding: 2rem 1.5rem; }
  .value-icon {
    display: inline-grid; place-items: center;
    width: 60px; height: 60px; margin-bottom: 1rem;
    border-radius: 16px; background: var(--orange-soft); color: var(--orange-dark);
  }
  .value h3 { margin-bottom: 0.4rem; }
  .value p { color: var(--muted); margin: 0; }

  .feat { padding: 0.5rem; }
  .feat-icon {
    display: inline-grid; place-items: center;
    width: 50px; height: 50px; margin-bottom: 0.8rem;
    border-radius: 12px; background: var(--charcoal); color: var(--orange);
  }
  .feat h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .feat p { color: var(--muted); font-size: 0.93rem; margin: 0; }

  /* Director profile */
  .owner {
    display: grid;
    gap: 1.8rem;
    padding: clamp(1.6rem, 3vw, 2.6rem);
    align-items: center;
    max-width: 900px;
    margin-inline: auto;
  }
  @media (min-width: 720px) { .owner { grid-template-columns: auto 1fr; gap: 2.4rem; } }
  .owner-avatar {
    display: grid;
    place-items: center;
    width: 150px;
    height: 150px;
    margin-inline: auto;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--orange) 0%, var(--maroon) 100%);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 3rem;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow);
  }
  .owner-body h3 { margin-bottom: 0.2rem; }
  .owner-role {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--orange-dark);
    margin-bottom: 1rem;
  }
  .owner-body p { color: var(--muted); }
  .owner-body strong { color: var(--ink); }
  .owner-facts {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.55rem;
  }
  .owner-facts li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.93rem;
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--text);
  }
  .owner-facts svg { color: var(--orange); flex-shrink: 0; }

  .eyebrow--light { color: #ffb877; }
  .recog-grid { display: grid; gap: 1.8rem; align-items: center; }
  @media (min-width: 780px) { .recog-grid { grid-template-columns: auto 1fr; gap: 2.5rem; } }
  .recog-badge {
    display: inline-grid; place-items: center;
    width: 96px; height: 96px; flex-shrink: 0;
    border-radius: 24px;
    background: rgba(232, 119, 34, 0.16);
    color: var(--orange);
  }
  .recog-body p { color: #c9c3ba; margin-bottom: 1rem; }
  .recog-body strong { color: #fff; }
  .recog-note { font-size: 0.95rem; }
</style>
