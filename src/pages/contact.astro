---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, links } from '../data/site';
import { img } from '../data/images';

const addr = site.address;
const mapQuery = encodeURIComponent(
  'Pakzameen Travels and Tours, Mian Khan Road, Block 15, Sargodha, Pakistan'
);

const cards = [
  { icon: 'phone', label: 'Call us', value: site.phoneDisplay, href: links.tel },
  { icon: 'whatsapp', label: 'WhatsApp', value: site.whatsappDisplay, href: links.whatsapp() },
  { icon: 'mail', label: 'Email', value: site.email, href: links.mailto },
  { icon: 'pin', label: 'Visit us', value: `${addr.line1}, ${addr.city}`, href: links.mapsQuery },
];
---

<BaseLayout
  title="Contact"
  description="Contact Pakzameen Travels and Tours in Sargodha — call, WhatsApp, email or visit us for Umrah, Hajj, flights, visas and tours."
>
  <PageHero
    crumb="Contact"
    title="Get in Touch"
    subtitle="Have a question or ready to book? Reach us however suits you — we reply fast and love to help."
    image={img.airport}
  />

  <section class="section">
    <div class="container">
      <div class="contact-cards grid cols-4">
        {cards.map((c) => (
          <a href={c.href} class="cc card" target={c.icon === 'whatsapp' || c.icon === 'pin' ? '_blank' : undefined} rel="noopener">
            <span class="cc-icon"><Icon name={c.icon} size={24} /></span>
            <span class="cc-label">{c.label}</span>
            <span class="cc-value">{c.value}</span>
          </a>
        ))}
      </div>

      <div class="contact-main">
        <div class="form-wrap">
          <h2>Send us an enquiry</h2>
          <p class="muted">Fill in the form and we'll continue the conversation on WhatsApp — the fastest way to reach us.</p>
          <form id="enquiry-form" class="form">
            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" type="text" required placeholder="e.g. Ahmed Ali" />
            </div>
            <div class="field-row">
              <div class="field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" placeholder="03xx xxxxxxx" />
              </div>
              <div class="field">
                <label for="service">Interested in</label>
                <select id="service" name="service">
                  <option>Umrah Package</option>
                  <option>Hajj Package</option>
                  <option>Tour Package</option>
                  <option>Air Ticket</option>
                  <option>Visa Service</option>
                  <option>Hotel Booking</option>
                  <option>Something else</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us your dates, destination or any questions…"></textarea>
            </div>
            <button type="submit" class="btn btn--green btn--lg">
              <Icon name="whatsapp" size={20} /> Send via WhatsApp
            </button>
            <p class="form-note">By sending, WhatsApp will open with your message ready to go.</p>
          </form>
        </div>

        <aside class="info">
          <div class="info-block card">
            <h3>Office details</h3>
            <ul class="info-list">
              <li><Icon name="pin" size={18} /><span>{addr.line1}<br />{addr.line2}<br />{addr.city}, {addr.region} {addr.postal}</span></li>
              <li><Icon name="phone" size={18} /><a href={links.tel}>{site.phoneDisplay}</a></li>
              <li><Icon name="whatsapp" size={18} /><a href={links.whatsapp()} target="_blank" rel="noopener">{site.whatsappDisplay}</a></li>
              <li><Icon name="clock" size={18} /><span>{site.hours}</span></li>
            </ul>
          </div>
          <div class="map card">
            <iframe
              title="Map to Pakzameen Travels and Tours"
              src={`https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-cards { margin-bottom: 3rem; }
  .cc {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 0.35rem; padding: 1.6rem 1rem; color: var(--text);
  }
  .cc-icon {
    display: inline-grid; place-items: center;
    width: 52px; height: 52px; margin-bottom: 0.5rem;
    border-radius: 14px; background: var(--orange-soft); color: var(--orange-dark);
  }
  .cc-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .cc-value { font-family: var(--font-head); font-weight: 600; color: var(--ink); word-break: break-word; }

  .contact-main { display: grid; gap: 2.5rem; }
  @media (min-width: 940px) { .contact-main { grid-template-columns: 1.2fr 1fr; } }

  .form-wrap h2 { margin-bottom: 0.4rem; }
  .muted { color: var(--muted); }
  .form { display: grid; gap: 1.1rem; margin-top: 1.4rem; }
  .field { display: grid; gap: 0.4rem; }
  .field-row { display: grid; gap: 1.1rem; }
  @media (min-width: 520px) { .field-row { grid-template-columns: 1fr 1fr; } }
  .field label { font-family: var(--font-head); font-weight: 500; font-size: 0.9rem; }
  .field input, .field select, .field textarea {
    font-family: var(--font-body); font-size: 1rem;
    padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 10px;
    background: #fff; color: var(--text); width: 100%;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--orange); box-shadow: 0 0 0 3px rgba(232,119,34,0.15);
  }
  .field textarea { resize: vertical; }
  .form-note { font-size: 0.82rem; color: var(--muted); margin: 0; }

  .info { display: grid; gap: 1.5rem; align-content: start; }
  .info-block { padding: 1.6rem; }
  .info-block h3 { margin-bottom: 1rem; }
  .info-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .info-list li { display: flex; gap: 0.7rem; align-items: flex-start; font-size: 0.95rem; }
  .info-list svg { color: var(--orange); flex-shrink: 0; margin-top: 3px; }
  .map { overflow: hidden; padding: 0; min-height: 260px; }
  .map iframe { width: 100%; height: 100%; min-height: 260px; border: 0; display: block; }
</style>

<script is:inline define:vars={{ waNumber: site.whatsappNumber }}>
  const form = document.getElementById('enquiry-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = (data.get('name') || '').toString().trim();
    const phone = (data.get('phone') || '').toString().trim();
    const service = (data.get('service') || '').toString();
    const message = (data.get('message') || '').toString().trim();
    const lines = [
      `Assalam-o-Alaikum! My name is ${name}.`,
      `I'm interested in: ${service}.`,
    ];
    if (phone) lines.push(`Phone: ${phone}`);
    if (message) lines.push('', message);
    const text = encodeURIComponent(lines.join('\n'));
    window.open(`https://wa.me/${waNumber}?text=${text}`, '_blank');
  });
</script>
