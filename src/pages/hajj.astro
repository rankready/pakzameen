---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PackageCard from '../components/PackageCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Figure from '../components/Figure.astro';
import { hajjPackages } from '../data/content';
import { img } from '../data/images';

const highlights = [
  { icon: 'shield', title: 'Approved & Guided', desc: 'Guidance in line with Government of Pakistan Hajj schemes and requirements.' },
  { icon: 'mosque', title: 'Manasik Training', desc: 'Pre-departure training so you perform every rite with confidence.' },
  { icon: 'hotel', title: 'Quality Accommodation', desc: 'Hotels and Mina/Arafat arrangements chosen for comfort and proximity.' },
  { icon: 'headset', title: 'Experienced Group Leaders', desc: 'Trained mualims accompany and support your group throughout.' },
];
---

<BaseLayout
  title="Hajj Packages"
  description="Government-approved Hajj packages from Pakzameen Travels and Tours with complete guidance from application to return."
>
  <PageHero
    crumb="Hajj"
    title="Hajj Packages"
    subtitle="Perform the fifth pillar of Islam with complete peace of mind. From documentation to your return home, we guide you at every step."
    image={img.makkahHaram}
  />

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Our Hajj packages</span>
        <h2>Comfortable, well-organised Hajj</h2>
        <p>Hajj operates under Government of Pakistan schemes with seasonal quotas and pricing. Contact us early to secure your place — we'll guide you through the whole process.</p>
      </div>
      <div class="grid cols-3 hajj-grid">
        {hajjPackages.map((p) => <PackageCard pkg={p} kind="Hajj" />)}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="split">
        <Figure src={img.praying} alt="Pilgrim in prayer" ratio="4 / 3" class="split-img" />
        <div>
          <span class="eyebrow">Why book your Hajj with us</span>
          <h2>You focus on worship — we handle the rest</h2>
          <ul class="hl-list">
            {highlights.map((h) => (
              <li>
                <span class="hl-icon"><Icon name={h.icon} size={22} /></span>
                <div><strong>{h.title}</strong><span>{h.desc}</span></div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container note-wrap">
      <div class="note card">
        <span class="note-icon"><Icon name="shield" size={24} /></span>
        <div>
          <h3>A note on Hajj pricing &amp; quotas</h3>
          <p>Hajj packages, quotas and prices are set each season under Government of Pakistan policy and are confirmed closer to the Hajj period. Register your interest with us now and we'll notify you as soon as details are announced.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Planning for Hajj?" text="Register your interest today and we'll guide you from application to a safe return." />
</BaseLayout>

<style>
  .hajj-grid { max-width: 820px; margin-inline: auto; }
  @media (min-width: 960px) { .hajj-grid { grid-template-columns: repeat(2, 1fr); } }

  .split { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1.2fr; } }
  .hl-list { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1.2rem; }
  .hl-list li { display: flex; gap: 0.9rem; }
  .hl-icon {
    display: inline-grid; place-items: center;
    width: 46px; height: 46px; flex-shrink: 0;
    border-radius: 12px; background: var(--orange-soft); color: var(--orange-dark);
  }
  .hl-list strong { display: block; font-family: var(--font-head); }
  .hl-list span { font-size: 0.92rem; color: var(--muted); }

  .note-wrap { max-width: 860px; }
  .note { display: flex; gap: 1.2rem; padding: 1.6rem; align-items: flex-start; background: var(--orange-soft); border-color: #f2d3b4; }
  .note-icon {
    display: inline-grid; place-items: center;
    width: 48px; height: 48px; flex-shrink: 0;
    border-radius: 12px; background: #fff; color: var(--orange-dark);
  }
  .note h3 { margin-bottom: 0.4rem; }
  .note p { margin: 0; color: #7a5a3a; }
</style>
