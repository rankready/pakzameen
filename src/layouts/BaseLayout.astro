---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, links } from '../data/site';
import { services } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  schema?: Record<string, unknown>[]; // extra JSON-LD objects for this page
}

const {
  title,
  description = 'Pakzameen Travels and Tours — trusted Umrah packages, air tickets, visit & study visa, travel insurance, GAMCA medical, E-Protector, document attestation and Azerbaijan tours from Sargodha, Pakistan.',
  image = '/og-image.png',
  keywords = 'Pakzameen Travels and Tours, travel agency Sargodha, Umrah packages Pakistan, visit visa, study visa, air tickets, Azerbaijan tour packages, travel insurance, GAMCA medical token, E-Protector, Wakala services, documents attestation, hotel booking, Sargodha travel agent',
  schema = [],
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Umrah, Visa, Tickets & Tours in Sargodha`;
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
const socials = Object.values(site.socials).filter(Boolean);

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': new URL('#organization', base).href,
  name: site.name,
  legalName: `${site.name} (Regd.)`,
  description,
  url: base.href,
  logo: new URL('/logo.png', base).href,
  image: ogImage,
  telephone: site.phoneIntl,
  email: site.email,
  priceRange: '$$',
  currenciesAccepted: 'PKR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: 'PK',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 32.0836,
    longitude: 72.6711,
  },
  areaServed: ['Sargodha', 'Punjab', 'Pakistan'],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '09:00',
      closes: '20:00',
    },
  ],
  ...(socials.length ? { sameAs: socials } : {}),
  makesOffer: services.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.title, description: s.desc },
  })),
};

const allSchema = [organizationLd, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Local SEO -->
    <meta name="geo.region" content="PK-PB" />
    <meta name="geo.placename" content="Sargodha" />
    <meta name="geo.position" content="32.0836;72.6711" />
    <meta name="ICBM" content="32.0836, 72.6711" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#e87722" />
    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Floating WhatsApp button -->
    <a
      class="wa-float"
      href={links.whatsapp()}
      target="_blank"
      rel="noopener"
      aria-label="Chat on WhatsApp"
    >
      <Icon name="whatsapp" size={28} />
    </a>

    <style>
      .wa-float {
        position: fixed;
        right: clamp(1rem, 3vw, 1.6rem);
        bottom: clamp(1rem, 3vw, 1.6rem);
        z-index: 60;
        display: grid;
        place-items: center;
        width: 58px; height: 58px;
        border-radius: 50%;
        background: #25d366;
        color: #fff;
        box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
        animation: wa-pulse 2.4s infinite;
      }
      .wa-float:hover { color: #fff; transform: scale(1.06); }
      @keyframes wa-pulse {
        0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
        70% { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
        100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
      }
    </style>
  </body>
</html>
