---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { links, site } from '../data/site';

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Umrah', href: '/umrah' },
  { label: 'Hajj', href: '/hajj' },
  { label: 'Tours', href: '/tours' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <Logo class="brand-logo" />
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-cta">
      <a href={links.tel} class="phone-link">
        <Icon name="phone" size={18} />
        <span>{site.phoneDisplay}</span>
      </a>
      <a href={links.whatsapp()} class="btn btn--green" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} /> WhatsApp
      </a>
    </div>

    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label="Mobile">
      {nav.map((item) => (
        <a href={item.href} class:list={['mobile-link', { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="mobile-actions">
      <a href={links.tel} class="btn btn--ghost"><Icon name="phone" size={18} /> Call now</a>
      <a href={links.whatsapp()} class="btn btn--green" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} /> WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(253, 251, 247, 0.9);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.2s ease;
  }
  .site-header.scrolled { box-shadow: var(--shadow); }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    min-height: 74px;
  }
  .brand { display: flex; align-items: center; flex-shrink: 0; }
  .brand-logo { height: 46px; width: auto; }

  .nav {
    display: none;
    margin-left: auto;
    gap: 0.25rem;
  }
  .nav-link {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text);
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    position: relative;
  }
  .nav-link:hover { color: var(--orange-dark); background: var(--orange-soft); }
  .nav-link.active { color: var(--orange-dark); }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0.8rem; right: 0.8rem; bottom: 0.15rem;
    height: 2px;
    background: var(--orange);
    border-radius: 2px;
  }

  .header-cta { display: none; align-items: center; gap: 0.9rem; }
  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .phone-link:hover { color: var(--orange-dark); }
  .phone-link svg { color: var(--orange); }

  .menu-toggle {
    margin-left: auto;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px; height: 44px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    width: 20px; height: 2px;
    margin-inline: auto;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-nav {
    border-top: 1px solid var(--border);
    padding: 1rem clamp(1.1rem, 4vw, 2rem) 1.5rem;
    background: var(--bg);
  }
  .mobile-nav nav { display: flex; flex-direction: column; }
  .mobile-link {
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--text);
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--border);
  }
  .mobile-link.active { color: var(--orange-dark); }
  .mobile-actions { display: flex; gap: 0.75rem; margin-top: 1.1rem; }
  .mobile-actions .btn { flex: 1; }

  @media (min-width: 992px) {
    .nav, .header-cta { display: flex; }
    .menu-toggle { display: none; }
    .mobile-nav { display: none !important; }
    .brand-logo { height: 50px; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const header = document.getElementById('site-header');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (mobileNav) mobileNav.hidden = open;
  });

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('scrolled', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
