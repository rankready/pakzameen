---
import Icon from './Icon.astro';
import { links, site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to start your journey?',
  text = 'Talk to our travel experts today. We reply fast on WhatsApp and love a good travel plan.',
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a href={links.whatsapp()} class="btn btn--light btn--lg" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={20} /> Chat on WhatsApp
      </a>
      <a href={links.tel} class="btn btn--ghost btn--lg cta-call">
        <Icon name="phone" size={18} /> {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(135deg, var(--orange) 0%, var(--orange-dark) 100%);
    color: #fff;
  }
  .cta-inner {
    display: grid;
    gap: 1.6rem;
    padding-block: clamp(2.6rem, 5vw, 3.8rem);
    align-items: center;
  }
  @media (min-width: 820px) {
    .cta-inner { grid-template-columns: 1.4fr 1fr; }
  }
  .cta-band h2 { color: #fff; margin-bottom: 0.4rem; }
  .cta-band p { color: rgba(255, 255, 255, 0.92); margin: 0; max-width: 46ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  @media (min-width: 820px) { .cta-actions { justify-content: flex-end; } }
  .cta-call { color: #fff; border-color: rgba(255,255,255,0.6); }
  .cta-call:hover { background: rgba(255,255,255,0.14); color: #fff; border-color: #fff; }
</style>
