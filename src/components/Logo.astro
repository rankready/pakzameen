---
/**
 * SVG recreation of the Pakzameen brand mark: an orange swoosh/globe with a
 * plane taking off, "Pakzameen" in orange and "Travels and Tours" beneath.
 *
 * To use the real logo instead: drop the PNG into /public (e.g. logo.png)
 * and replace the <svg> below with <img src="/logo.png" alt="..." />.
 */
interface Props {
  variant?: 'full' | 'mark';
  onDark?: boolean;
  class?: string;
}
const { variant = 'full', onDark = false, class: className = '' } = Astro.props;
const textColor = onDark ? '#ffffff' : '#1f2429';
---

<svg
  class={className}
  viewBox={variant === 'mark' ? '0 0 66 56' : '0 0 300 78'}
  role="img"
  aria-label="Pakzameen Travels and Tours"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Mark: swoosh + plane -->
  <g>
    <path
      d="M14 8 C-2 20 -2 44 16 54 C4 40 6 22 22 12 Z"
      fill="#e87722"
    />
    <path
      d="M20 30 C30 22 40 20 50 22"
      fill="none"
      stroke="#e87722"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <path
      d="M46 20 L60 15 C62 14.4 63.6 16 63 18 L58 26 L64 30 C64.8 30.5 64.6 31.7 63.6 32 L57 33 L54 38 L52 32 L47 30 L52 27 Z"
      fill="#e87722"
    />
  </g>

  {variant === 'full' && (
    <g>
      <text
        x="72"
        y="40"
        font-family="Poppins, sans-serif"
        font-weight="700"
        font-size="30"
        fill="#e87722"
        letter-spacing="-0.5"
      >Pakzameen</text>
      <text
        x="73"
        y="64"
        font-family="Poppins, sans-serif"
        font-weight="600"
        font-size="17"
        fill={textColor}
        letter-spacing="0.5"
      >Travels <tspan fill="#8a2b1c">and</tspan> Tours</text>
    </g>
  )}
</svg>
