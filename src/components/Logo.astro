---
/**
 * Pakzameen brand logo (real artwork at /public/logo.jpeg).
 *
 * The logo has a white background with dark text, so on dark surfaces
 * (footer) it's shown on a white rounded chip to stay legible.
 */
interface Props {
  onDark?: boolean;
  class?: string;
}
const { onDark = false, class: className = '' } = Astro.props;
---

<img
  src="/logo.jpeg"
  alt="Pakzameen Travels and Tours"
  width="1370"
  height="721"
  decoding="async"
  class:list={['logo-img', { 'on-dark': onDark }, className]}
/>

<style>
  .logo-img {
    display: block;
    height: 48px;
    width: auto;
  }
  .logo-img.on-dark {
    height: 44px;
    background: #ffffff;
    padding: 8px 12px;
    border-radius: 12px;
    box-sizing: content-box;
  }
</style>
